    "res, imgdif = cv2.threshold(dif, 30, 255, cv2.THRESH_BINARY)\n",
    "#Visualiza\n",
    "plt.subplot(1, 2, 2)\n",
    "plt.title(\"Mayores\")\n",
    "plt.axis(\"off\")\n",
    "plt.imshow(imgdif, cmap='gray') \n",
    "plt.show()\n"
